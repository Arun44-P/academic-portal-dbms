# ==============================================================================
# ACADEMIA Academic & Research Portal - Environment Configuration Template
# ==============================================================================

# Database Connection (Option 1: Recommended Hosted SQL URL)
# Example MySQL: mysql://username:password@gateway01.tidbcloud.com:4000/academic_portal_db
# Example Postgres: postgresql://username:password@host.supabase.co:5432/academic_portal_db
DATABASE_URL=mysql://root:your_password@127.0.0.1:3306/academic_portal_db

# Database Connection (Option 2: Discrete MySQL Parameters)
DB_ENGINE=mysql
DB_NAME=academic_portal_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_SSL=false

# Security & Application Settings
SECRET_KEY=generate-a-strong-random-secret-key-for-production
DEBUG=False
ALLOWED_HOSTS=*
